{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "routes": [
    { "src": "/health", "dest": "/api/health.js" },
    { "src": "/v1/skip-times/vote", "dest": "/api/v1/skip-times/vote.js" },
    { "src": "/v1/skip-times/vote/(.*)", "dest": "/api/v1/skip-times/vote.js" },
    { "src": "/v1/skip-times/([0-9]+)/([0-9.]+)", "dest": "/api/v1/skip-times/[anime_id]/[episode_number].js" },
    { "src": "/v1/rules/([0-9]+)", "dest": "/api/v1/rules/[anime_id].js" },
    { "src": "/v2/skip-times/vote", "dest": "/api/v2/skip-times/vote.js" },
    { "src": "/v2/skip-times/vote/(.*)", "dest": "/api/v2/skip-times/vote.js" },
    { "src": "/v2/skip-times/([0-9]+)/([0-9.]+)", "dest": "/api/v2/skip-times/[animeId]/[episodeNumber].js" },
    { "src": "/v2/relation-rules/([0-9]+)", "dest": "/api/v2/relation-rules/[animeId].js" }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}